# Copy to .env — never commit real values.

# ─── Mode ─────────────────────────────────────────────────────────────────────
# local  = offline, canned triage response, no cloud calls (works on a plane)
# azure  = calls the deployed Azure OpenAI account via DefaultAzureCredential
MODE=local

# ─── Azure OpenAI (only required for MODE=azure) ─────────────────────────────
# The endpoint of your deployed AOAI account, e.g. from
#   `terraform output workload_summary` in azure/workloads/insurance-app.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── CORS (empty is fine — Caddy front-door means same-origin) ───────────────
CORS_ORIGINS=

# For MODE=azure locally: sign in via `az login` before `make start`. In an
# Azure-hosted container, attach a user-assigned managed identity —
# DefaultAzureCredential picks it up automatically (no keys, no secrets).
