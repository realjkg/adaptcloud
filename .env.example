# ══════════════════════════════════════════════════════════════════════════════
# AIDigest — Environment Variables
# "make setup" writes .env for you. To fill it in by hand instead:
#
#   cp .env.example .env
#   nano .env          ← or use any editor
#   make start
#
# SECURITY: .env is in .gitignore and must NEVER be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Claude API ────────────────────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── AIDigest (https://<host>/aidigest, behind Caddy basic auth) ───────────────
# Add to an existing .env with: make setup-aidigest  (append-only).
# Uses ANTHROPIC_API_KEY above and its OWN least-privilege Postgres role that owns
# schema "aidigest" (SQL in AIDigest/README.md):
AIDIGEST_DATABASE_URL=
# Enables the "aidigest" compose profile for make start / docker compose up:
# COMPOSE_PROFILES=aidigest
# Shared secret Caddy sends to the AIDigest service (openssl rand -hex 32)
AIDIGEST_PROXY_SECRET=
# Basic-auth user for /aidigest/*: 1-64 of A-Z a-z 0-9 . _ @ - (must not contain AIDIGEST_VALUE_END)
AIDIGEST_BASIC_AUTH_USER=
# bcrypt hash of that user's password: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the single quotes - the hash contains "$".
AIDIGEST_BASIC_AUTH_HASH=''
# Optional overrides (defaults: claude-sonnet-5-5, 12:30 UTC)
# AIDIGEST_MODEL=
# AIDIGEST_DAILY_TIME=
