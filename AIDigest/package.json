{
  "name": "adaptcloud-aidigest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute DB --local --file=./schema.sql --yes",
    "db:init:remote": "wrangler d1 execute DB --remote --file=./schema.sql --yes",
    "bootstrap:cloudflare": "wrangler deploy && wrangler d1 execute DB --remote --file=./schema.sql --yes && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.45.0"
  }
}
