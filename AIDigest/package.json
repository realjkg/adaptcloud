{
  "name": "adaptcloud-aidigest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute adaptcloud-ai-digest --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute adaptcloud-ai-digest --remote --file=./schema.sql"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.40.0"
  }
}
